# Cache and security headers for the Cloudflare Worker.
#
# Rules are ADDITIVE: a path matching several blocks gets each block's headers
# appended, not overridden. So Cache-Control must never appear in /* — a broad
# value there concatenates with the specific one and, since browsers honour the
# first directive, silently wins. Only non-conflicting headers belong in /*.
#
# The build names its scripts and styles by their content, so those never
# change under a name. Everything else keeps its name when it changes, so its
# lifetime stays conservative.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/
  Cache-Control: public, max-age=300, must-revalidate

/index.html
  Cache-Control: public, max-age=300, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker: the browser checks it for a new release on every visit,
# and no cache on the way should answer for it. src/sw.js has the rest.
/sw.js
  Cache-Control: no-cache

# Club art effectively never changes, and a new club means a new filename.
/images/clubs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The icons change rarely, but keep the same names when they do.
/icon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/manifest.webmanifest
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/data/clubs.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
