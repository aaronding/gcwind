// The Worker behind gcwind.webthinking.io: the site's static build, and the
// /api endpoints in worker/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gcwind",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-15",

  // Built by `pnpm run build`. Response headers for these files come from
  // _headers. Only /api/* runs the Worker: every other request is a file,
  // served without running any code — including scanners probing for paths
  // that do not exist.
  "assets": {
    "directory": "./_site",
    "run_worker_first": ["/api/*"]
  },

  // gcwind.webthinking.io is the only address. No *.workers.dev address and no
  // preview URLs, so nothing outside ever depends on a Cloudflare one.
  "routes": [{ "pattern": "gcwind.webthinking.io", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // The database, by name and without an id: `wrangler deploy` creates it the
  // first time and finds it by name after, and
  // `wrangler d1 migrations apply gcwind --remote` adds its tables from
  // migrations/.
  "d1_databases": [{ "binding": "DB", "database_name": "gcwind" }],

  // Three messages a minute from one address, counted at each Cloudflare
  // location. The namespace id is any number unique among this account's rate
  // limiters.
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "2001", "simple": { "limit": 3, "period": 60 } }
  ],

  // The daily purge of messages kept a year, at 04:23 UTC.
  "triggers": { "crons": ["23 4 * * *"] },

  // The Worker's own errors are logged, but not a record of each request, whose
  // headers carry the sender's IP address.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
