{
  "name": "gcwind",
  "version": "3.1.1",
  "description": "Golf Clash wind ring calculator",
  "homepage": "https://gcwind.webthinking.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronding/gcwind.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node tools/validate-clubs.js",
    "images": "node tools/optimize-images.js",
    "icons": "node tools/generate-icons.js",
    "build:site": "vite build && find _site -name '.DS_Store' -delete",
    "deploy": "wrangler deploy && node tools/check-deploy.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node tools/generate-fixtures.js",
    "test:e2e": "playwright test",
    "test:e2e:prod": "BASE_URL=https://gcwind.webthinking.io playwright test",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "feedback": "node tools/read-feedback.js",
    "db:migrate": "wrangler d1 migrations apply gcwind --remote",
    "dev:worker": "wrangler dev",
    "check:deploy": "node tools/check-deploy.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "eslint": "^9.17.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.4",
    "svelte": "^5.57.2",
    "svelte-eslint-parser": "^1.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  },
  "packageManager": "pnpm@12.6.0"
}
